# Copy this file to .env.local and fill in the values.

# Music card (https://www.last.fm/api/account/create)
# Connect Spotify to Last.fm in Last.fm settings > Applications so plays show up.
LASTFM_USERNAME=
LASTFM_API_KEY=

# "Last visit from" footer (free database at https://upstash.com -> Redis -> REST API)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: link the music card to the exact song on Spotify instead of a Spotify search.
# Create a free app at https://developer.spotify.com/dashboard and copy its Client ID and secret.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
